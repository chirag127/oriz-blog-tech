---
/**
 * PostCard — a drawing-sheet ledger row for the left-sidebar shell.
 *
 * Distinct from the sibling "kicker-rule" card: each entry is framed like a
 * sheet in a drawing register — a mono sheet-tab on the left (date + desk),
 * a Space Grotesk headline + dek in the middle, and a discipline tick. The
 * whole row is boxed on hover like a selected drawing. No shadow, no radius.
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const vert = postVertical(post)
---

<article class="sheet" data-vertical={vert}>
  <a class="sheet-link" href={href}>
    <span class="sheet-tab mono">
      <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      <span class="sheet-desk">{verticalLabel(vert)}</span>
    </span>
    <span class="sheet-body">
      <h3 class="sheet-title">{title}</h3>
      <p class="sheet-desc">{description}</p>
      <span class="sheet-foot mono">
        <span class="sheet-cat">{category}</span>
        {readingTime && <span class="sheet-rt">{readingTime}</span>}
      </span>
    </span>
    <span class="sheet-tick" aria-hidden="true"></span>
  </a>
</article>

<style>
  .sheet {
    --v: var(--v-personal);
    border-top: 1px solid var(--rule);
  }
  .sheet[data-vertical='dev'] { --v: var(--v-dev); }
  .sheet[data-vertical='finance'] { --v: var(--v-finance); }
  .sheet[data-vertical='culture'] { --v: var(--v-culture); }
  .sheet[data-vertical='health'] { --v: var(--v-health); }

  .sheet-link {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) 6px;
    gap: 1.25rem;
    align-items: start;
    padding: 1.1rem 0.75rem 1.2rem;
    margin-inline: -0.75rem;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid transparent;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .sheet-link:hover {
    background: color-mix(in oklab, var(--v) 6%, transparent);
    border-color: color-mix(in oklab, var(--v) 30%, transparent);
  }
  .sheet-link:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  .sheet-tab {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    padding-top: 0.15rem;
  }
  .sheet-tab time { color: var(--ink); }
  .sheet-desk {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--v);
    font-weight: 500;
  }

  .sheet-body { min-width: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .sheet-title {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.18;
    margin: 0;
    color: var(--ink);
  }
  .sheet-link:hover .sheet-title { color: var(--accent); }
  .sheet-desc {
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
    max-width: 62ch;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
  }
  .sheet-foot {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    margin-top: 0.15rem;
  }
  .sheet-cat { text-transform: uppercase; letter-spacing: 0.1em; }
  .sheet-rt::before { content: '·'; margin-right: 0.75rem; color: var(--rule-strong); }

  .sheet-tick {
    align-self: stretch;
    background: color-mix(in oklab, var(--v) 40%, transparent);
    transition: background var(--dur-fast) ease;
  }
  .sheet-link:hover .sheet-tick { background: var(--v); }

  @media (max-width: 560px) {
    .sheet-link {
      grid-template-columns: minmax(0, 1fr) 6px;
      gap: 0.75rem;
    }
    .sheet-tab {
      flex-direction: row;
      gap: 0.5rem;
      grid-column: 1 / -1;
    }
    .sheet-tab .sheet-desk { border-left: 1px solid var(--rule); padding-left: 0.5rem; }
  }
</style>
