---
/*
 * Footer — "title-block strip" for the left-sidebar shell.
 *
 * The rail already carries nav + family + source, so the footer is
 * deliberately NOT the sibling 4-column masthead. It's a single boxed
 * title-block strip: a signature drafting line, a compact field row
 * (categories / feed), and the legal line. Sits inside the content column.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import { getCategoriesWithCounts, slugifyTag } from '~/lib/blog'

const categories = (await getCategoriesWithCounts())
  .slice(0, 6)
  .map(({ category }) => ({ name: category, slug: slugifyTag(category) }))
---
<footer class="blog-footer" role="contentinfo">
  <div class="bf-inner">
    <div class="bf-titleblock">
      <p class="bf-sig mono">DWG · Blueprint — field notebook</p>
      <p class="bf-note">
        Read it like a drawing: dimensioned so you can build from it.
      </p>
    </div>

    <nav class="bf-fields mono" aria-label="Disciplines">
      <span class="bf-fh">Disciplines</span>
      <span class="bf-links">
        {categories.map((c, i) => (
          <>
            {i > 0 && <span class="bf-sep" aria-hidden="true">/</span>}
            <a href={`/categories/${c.slug}/`}>{c.name}</a>
          </>
        ))}
      </span>
    </nav>
  </div>

  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-tech"
    appName="Blueprint"
    bio="Buildable, deep notes on shipping and running production software by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .blog-footer {
    margin-top: 5rem;
    background: var(--paper-2, transparent);
    color: var(--ink);
    border-top: 2px solid var(--rule-strong);
  }
  .bf-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 2.5rem clamp(1.25rem, 4vw, 2rem) 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .bf-titleblock {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
  }
  .bf-sig {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 0.5rem;
  }
  .bf-note {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 2.4vw, 1.5rem);
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--ink);
    margin: 0;
    max-width: 36ch;
  }
  .bf-fields {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    font-size: 11px;
  }
  .bf-fh {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-mute);
  }
  .bf-links { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0.375rem; }
  .bf-links a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }
  .bf-links a:hover { color: var(--accent); border-color: var(--accent); }
  .bf-sep { color: var(--rule-strong); }

  @media (min-width: 768px) {
    .bf-inner {
      grid-template-columns: 1fr auto;
      align-items: end;
      padding-top: 3rem;
    }
  }
</style>
